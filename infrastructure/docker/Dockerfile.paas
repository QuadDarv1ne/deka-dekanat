# syntax=docker/dockerfile:1.7
#
# Multi-stage Dockerfile for the Дека (deka-dekanat) portal — PaaS-compatible.
#
# Designed for Railway, Render, and similar PaaS providers that:
#   - Provide PostgreSQL as a managed service (separate from the app container)
#   - Inject DATABASE_URL automatically as an env var
#   - Support healthchecks via HTTP probes
#
# This image does NOT include PostgreSQL — it expects an external database
# reachable via $DATABASE_URL. Use Dockerfile.fly if you need everything in one
# container (e.g., for Fly.io or self-hosted VPS).
#
# Build:
#   docker build -f infrastructure/docker/Dockerfile.paas \
#     -t deka-paas \
#     /home/z/my-project/deka-dekanat
#
# Run locally (against an external DB):
#   docker run --rm -p 5180:5180 \
#     -e DATABASE_URL='postgres://user:pass@host:5432/deka' \
#     -e DEMO_MODE=true \
#     deka-paas
#

# ---- Stage 1: build SvelteKit app -----------------------------------------
FROM node:22-bookworm-slim AS build
WORKDIR /workspace/apps/portal

# Copy sources first — we need scripts/patch-csrf.mjs available before npm ci.
COPY apps/portal/ ./

# Install build dependencies (svelte-check, vite, typescript).
COPY apps/portal/package.json apps/portal/package-lock.json ./
RUN npm ci --ignore-scripts && node scripts/patch-csrf.mjs

# Build the production bundle.
RUN npx svelte-kit sync && npx vite build

# ---- Stage 2: production dependencies ------------------------------------
FROM node:22-bookworm-slim AS prod-deps
WORKDIR /workspace/apps/portal
COPY apps/portal/package.json apps/portal/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

# ---- Stage 3: runtime (Node only) ----------------------------------------
FROM node:22-bookworm-slim AS runtime

# Application environment — defaults. Override via PaaS env vars.
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=5180 \
    DEMO_MODE=true \
    AI_BASE_URL= \
    AI_MODEL=

WORKDIR /workspace/apps/portal

# Copy app code from build stages.
COPY --from=prod-deps /workspace/apps/portal/node_modules ./node_modules
COPY --from=build /workspace/apps/portal/.output ./.output
COPY apps/portal/package.json ./package.json

# Database migration & seed tooling.
COPY database /workspace/database
COPY apps/portal/tooling/database ./tooling/database
COPY apps/portal/src/lib/server/security/credentials.mjs ./src/lib/server/security/credentials.mjs
COPY apps/portal/src/lib/modules/auth/preview-accounts.ts ./src/lib/modules/auth/preview-accounts.ts

# Start script: runs migrations (idempotent) → seed (idempotent) → app.
COPY infrastructure/docker/start-paas.sh /usr/local/bin/start-paas.sh
RUN chmod +x /usr/local/bin/start-paas.sh

# Healthcheck — make sure the app responds.
COPY infrastructure/docker/healthcheck.mjs ./tooling/healthcheck.mjs
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD ["node", "tooling/healthcheck.mjs"]

EXPOSE 5180
CMD ["start-paas.sh"]
