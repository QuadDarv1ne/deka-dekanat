# Контекст сборки: не отправляем в образ лишнее и не рискуем утечкой секретов.
node_modules
.next
out
build

# локальная база, снапшоты и секреты — данные конкретной установки
db
.env
.env.*
!.env.example
cookies*.txt

# журналы и служебные артефакты
*.log
dev*.log
prod*.log
tsconfig.tsbuildinfo
next-env.d.ts

# прочее окружение разработки
.git
.gitignore
.github
.vscode
docs
test
*.zip

# SvelteKit (apps/portal) — артефакты и зависимости не должны попадать в
# build-context Dockerfile.paas / Dockerfile.fly (контекст = корень репозитория).
# Иначе локальные node_modules (двоичники Windows) раздувают контекст и ломают npm ci.
apps/portal/node_modules
**/.svelte-kit
**/.output
**/.turbo

# локальные данные установки и вспомогательные директории
var
new
apps/portal/tests
