# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config

# журналы и приложенные вручную архивы — в репозиторий не попадают
*.log
/test/
prompt

# вручную приложенные архивы исходников (не путать со сборкой public/deka-dekanat-*)
/*.zip
/*.tar.gz

# Skills directory
/skills/
# секреты окружения — в репозиторий не попадают
.env
.env.local
.env*.production
db/*.db
db/auth-secret.txt

# cookie-jar с живыми сессиями (curl --cookie-jar) — не коммитим
cookies*.txt

# служебные каталоги среды разработки — в репозиторий не входят
/.zscripts/
/Caddyfile
/examples/
/mini-services/
/tests/
/tool-results/
/download/
/upload/
/scripts/pdf-work/
/.agent*
/.session*
/.next-env*

# файловые снапшоты базы — в репозиторий не входят
db/snapshots/
