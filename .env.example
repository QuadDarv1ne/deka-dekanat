# «Дека» — переменные окружения.
# Скопируйте файл и подставьте свои значения:  cp .env.example .env

# Секрет подписи JWT-сессий (httpOnly-cookie).
# ОБЯЗАТЕЛЬНО сгенерируйте свой перед запуском:  openssl rand -hex 32
AUTH_SECRET=ЗАМЕНИТЕ_НА_СВОЙ_СЕКРЕТ_64_hex_символа

# База данных SQLite. Путь указывается относительно prisma/schema.prisma,
# поэтому «../db/custom.db» означает <корень проекта>/db/custom.db.
# Файл базы и папка db/ не хранятся в git — создаются командой «bun run db:push» (или npm run db:push).
DATABASE_URL=file:../db/custom.db

# ── ИИ-ассистент (необязательно) ──────────────────────────────────────
# Ассистент работает по цепочке провайдеров:
#   1) LLM_API_KEY задан  → любой OpenAI-совместимый API (OpenAI, OpenRouter,
#      локальная Ollama, vLLM — университет может держать модель у себя);
#   2) иначе — платформенный SDK той среды, где запущен прототип;
#   3) иначе — встроенный офлайн-движок: отвечает по данным студента из базы
#      без внешних сервисов (кнопки-подсказки работают всегда).
# Если запускаете вне сред с готовым SDK — задайте свой провайдер:
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
